#: includes/class-admin.php:5809
msgid "Column order can be any order"
msgstr "Le colonne possono essere in qualsiasi ordine"

#: includes/class-admin.php:5810
msgid "Extra columns are allowed and will be ignored"
msgstr "Sono ammesse colonne aggiuntive, che verranno ignorate"

#: includes/class-admin.php:5811
msgid "Date formats supported: YYYY-MM-DD, DD/MM/YYYY, MM/DD/YYYY, DD-MM-YYYY, MM-DD-YYYY, DD.MM.YYYY"
msgstr "Formati di data supportati: AAAA-MM-GG, GG/MM/AAAA, MM/GG/AAAA, GG-MM-AAAA, MM-GG-AAAA, GG.MM.AAAA"

#: includes/class-admin.php:5812
msgid "Column names can be in English or in the language of the panel"
msgstr "I nomi delle colonne possono essere in inglese o nella lingua del pannello"

#: includes/class-admin.php:5813
msgid "The first row must contain column headers"
msgstr "La prima riga deve contenere le intestazioni delle colonne"

#: includes/class-admin.php:5816
msgid "Important Note about Date Formats:"
msgstr "Nota importante sui formati di data:"

#: includes/class-admin.php:5817
msgid "For ambiguous dates like \"01/10/2025\", the system cannot determine if this means \"January 10th\" or \"October 1st\". To avoid confusion:"
msgstr "Per date ambigue come \"01/10/2025\", il sistema non può stabilire se si intende \"10 gennaio\" o \"1 ottobre\". Per evitare confusione:"

#: includes/class-admin.php:5819
msgid "Use unambiguous formats like YYYY-MM-DD (2025-01-10)"
msgstr "Usa formati non ambigui come AAAA-MM-GG (2025-01-10)"

#: includes/class-admin.php:5820
msgid "Set your preferred date format below to ensure consistent interpretation"
msgstr "Imposta qui sotto il formato di data che preferisci, per garantire un'interpretazione coerente"

#: includes/class-admin.php:5831
msgid "Date Format Preference"
msgstr "Formato di data preferito"

#: includes/class-admin.php:5840
msgid "This preference is used to interpret ambiguous dates like \"01/10/2025\". Unambiguous dates are always parsed correctly regardless of this setting."
msgstr "Questa preferenza viene usata per interpretare date ambigue come \"01/10/2025\". Le date non ambigue vengono sempre interpretate correttamente, indipendentemente da questa impostazione."

#: includes/class-admin.php:5846
msgid "CSV File"
msgstr "File CSV"

#: includes/class-admin.php:5850
