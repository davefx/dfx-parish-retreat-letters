#: includes/class-admin.php:5782
msgid "Date formats supported: YYYY-MM-DD, DD/MM/YYYY, MM/DD/YYYY, DD-MM-YYYY, MM-DD-YYYY, DD.MM.YYYY"
msgstr "Formati di data supportati: AAAA-MM-GG, GG/MM/AAAA, MM/GG/AAAA, GG-MM-AAAA, MM-GG-AAAA, GG.MM.AAAA"

