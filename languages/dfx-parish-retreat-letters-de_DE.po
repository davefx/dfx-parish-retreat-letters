msgstr "Der in wp-config.php definierte Verschlüsselungsschlüssel stimmt nicht mit dem in der Datenbank gespeicherten überein."

#: includes/class-security.php:189
msgid "Warning:"
msgstr "Warnung:"

#: includes/class-security.php:190
